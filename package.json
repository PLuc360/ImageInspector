{
  "name": "image-inspector",
  "displayName": "Image Inspector",
  "description": "Displays image information (dimensions, size, format, metadata).",
  "version": "1.19.0",
  "publisher": "pierre-luc-guegan",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PLuc360/ImageInspector.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "imageInspector.previewEditor",
        "displayName": "Image Details Preview",
        "selector": [
          { "filenamePattern": "*.avif" },
          { "filenamePattern": "*.bmp" },
          { "filenamePattern": "*.gif" },
          { "filenamePattern": "*.heic" },
          { "filenamePattern": "*.heif" },
          { "filenamePattern": "*.ico" },
          { "filenamePattern": "*.jpeg" },
          { "filenamePattern": "*.jpg" },
          { "filenamePattern": "*.png" },
          { "filenamePattern": "*.svg" },
          { "filenamePattern": "*.tif" },
          { "filenamePattern": "*.tiff" },
          { "filenamePattern": "*.webp" }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Image Inspector Configuration",
      "properties": {
        "imageInspector.toolbarPosition": {
          "type": "string",
          "enum": ["top", "bottom", "left", "right"],
          "default": "top",
          "description": "Position of the toolbar in the image inspector webview (top, bottom, left, right)."
        },
        "imageInspector.themeAccentColor": {
          "type": "string",
          "default": "#00C86E",
          "pattern": "^#([0-9a-fA-F]{6})$",
          "description": "Accent color used by toolbar active tools, click halo, and selection rectangles (hex format: #RRGGBB)."
        },
        "imageInspector.imageDetailsBackgroundColor": {
          "type": "string",
          "default": "",
          "pattern": "^$|^#([0-9a-fA-F]{6})$",
          "description": "Custom background color used by the Image Details toolbar toggle. Leave empty to automatically use a light color on dark themes and a dark color on light themes."
        },
        "imageInspector.saveEditsToOriginalFile": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, rotation actions in Image Details overwrite the original image file on disk."
        },
        "imageInspector.pipetteLoupeDiameter": {
          "type": "number",
          "default": 96,
          "minimum": 48,
          "maximum": 256,
          "multipleOf": 1,
          "description": "Outer diameter of the color picker loupe in screen pixels."
        },
        "imageInspector.pipetteLoupeVirtualResolution": {
          "type": "number",
          "default": 25,
          "minimum": 5,
          "maximum": 101,
          "multipleOf": 1,
          "description": "Target virtual resolution of the loupe grid (odd values recommended for a true center pixel)."
        },
        "imageInspector.pipetteLoupeZoomAtMinImageZoom": {
          "type": "number",
          "default": 6,
          "minimum": 0.25,
          "maximum": 100,
          "description": "Loupe zoom target when image zoom is at its minimum (max zoom-out)."
        },
        "imageInspector.pipetteLoupeZoomAtMaxImageZoom": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 100,
          "description": "Loupe zoom target when image zoom is at its maximum (max zoom-in)."
        }
      }
    },
    "commands": [
      {
        "command": "imageInspector.showImageDetails",
        "title": "Image Inspector: Open with Details"
      },
      {
        "command": "imageInspector.pickThemeAccentColor",
        "title": "Image Inspector: Pick Accent Color"
      },
      {
        "command": "imageInspector.zoomIn",
        "title": "Image Inspector: Zoom +"
      },
      {
        "command": "imageInspector.zoomOut",
        "title": "Image Inspector: Zoom -"
      },
      {
        "command": "imageInspector.zoomReset",
        "title": "Image Inspector: Zoom 100%"
      },
      {
        "command": "imageInspector.zoomFit",
        "title": "Image Inspector: Zoom Fit"
      },
      {
        "command": "imageInspector.selectComparisonImage",
        "title": "Image Inspector: Set Comparison Image"
      },
      {
        "command": "imageInspector.openFolderGallery",
        "title": "Image Inspector: Open Image Gallery",
        "shortTitle": "Open Gallery",
        "icon": {
          "light": "assets/gallery-light.svg",
          "dark": "assets/gallery-dark.svg"
        }
      },
      {
        "command": "imageInspector.deleteSelectedGalleryImages",
        "title": "Image Inspector: Delete Selected Gallery Images"
      }
    ],
    "keybindings": [
      {
        "command": "imageInspector.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == imageInspector.previewEditor"
      },
      {
        "command": "imageInspector.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeCustomEditorId == imageInspector.previewEditor"
      },
      {
        "command": "imageInspector.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == imageInspector.previewEditor"
      },
      {
        "command": "imageInspector.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeCustomEditorId == imageInspector.previewEditor"
      },
      {
        "command": "imageInspector.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == imageInspector.previewEditor"
      },
      {
        "command": "imageInspector.deleteSelectedGalleryImages",
        "key": "delete",
        "when": "activeWebviewPanelId == imageInspector.folderGallery"
      },
      {
        "command": "imageInspector.deleteSelectedGalleryImages",
        "key": "backspace",
        "when": "activeWebviewPanelId == imageInspector.folderGallery"
      },
      {
        "command": "imageInspector.deleteSelectedGalleryImages",
        "key": "delete",
        "when": "webviewId == imageInspector.folderGallery"
      },
      {
        "command": "imageInspector.deleteSelectedGalleryImages",
        "key": "backspace",
        "when": "webviewId == imageInspector.folderGallery"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "imageInspector.showImageDetails",
          "when": "resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .jpeg || resourceExtname == .webp || resourceExtname == .gif || resourceExtname == .bmp || resourceExtname == .tif || resourceExtname == .tiff || resourceExtname == .avif || resourceExtname == .ico || resourceExtname == .svg || resourceExtname == .heic || resourceExtname == .heif"
        },
        {
          "command": "imageInspector.openFolderGallery",
          "when": "explorerResourceIsFolder"
        }
      ],
      "view/title": []
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "echo \"No lint configured\""
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "sharp": "^0.34.4"
  }
}
